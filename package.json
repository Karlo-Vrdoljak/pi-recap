{
  "name": "pi-recap",
  "version": "0.1.0",
  "description": "Pi extension that sets a session title and recap in the terminal UI",
  "author": "Fernando Bevilacqua",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karlo-Vrdoljak/pi-recap.git"
  },
  "homepage": "https://github.com/Karlo-Vrdoljak/pi-recap#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "recap",
    "terminal-title"
  ],
  "files": [
    "extensions/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/recap.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
